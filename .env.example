NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:7456,http://localhost:3000
TRUST_PROXY_HOPS=0
SERVE_TEST_CONSOLE=true
SWAGGER_ENABLED=true
HTTP_BODY_LIMIT=100kb
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_CONNECT_TIMEOUT_MS=10000
SOCKET_PING_TIMEOUT_MS=20000
DATABASE_URL=postgresql://game:game_password@localhost:5432/game_server?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT=10
SOCKET_RATE_WINDOW_MS=1000
SOCKET_EVENT_RATE_LIMIT=20
SOCKET_GAME_INPUT_RATE_LIMIT=30
SOCKET_MAX_CONNECTIONS_PER_USER=5

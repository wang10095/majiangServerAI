NODE_ENV=production
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://180.76.135.161,https://180.76.135.161
TRUST_PROXY_HOPS=1
SERVE_TEST_CONSOLE=false
SWAGGER_ENABLED=false
HTTP_BODY_LIMIT=100kb
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_CONNECT_TIMEOUT_MS=10000
SOCKET_PING_TIMEOUT_MS=20000
POSTGRES_DB=vcat_game
POSTGRES_USER=game
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql://game:__POSTGRES_PASSWORD__@postgres:5432/vcat_game?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT=10
SOCKET_RATE_WINDOW_MS=1000
SOCKET_EVENT_RATE_LIMIT=20
SOCKET_GAME_INPUT_RATE_LIMIT=30
SOCKET_MAX_CONNECTIONS_PER_USER=5